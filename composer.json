{
    "name": "nadi-pro/nadi-php",
    "description": "A PHP SDK for Nadi (http://nadi.pro)",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nadi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nadi\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Nasrul Hazim Bin Mohamad",
            "email": "nasrulhazim.m@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "guzzlehttp/guzzle": "^6.3.1|^7.0.1",
        "hisorange/browser-detect": "^4.5 | ^5.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "open-telemetry/api": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sem-conv": "^1.0",
        "ramsey/uuid": "^3.0 | ^4.7"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.15",
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^10.1 || ^11.0 || ^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "scripts": {
        "test" : "@php vendor/bin/phpunit",
        "format" : "@php vendor/bin/pint",
        "analyse" : "@php vendor/bin/phpstan analyse --no-progress"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
